<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/home_dest">

    <fragment
        android:id="@+id/events_dest"
        android:name="com.dmc.goyiyi.feature.events.ui.EventsFragment"
        android:label="Eventos">

    <action
        android:id="@+id/action_eventsDest_to_eventDetailDest"
        app:destination="@id/event_detail_dest" />
    </fragment>

    <fragment
        android:id="@+id/home_dest"
        android:name="com.dmc.goyiyi.feature.home.ui.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/map_dest"
        android:name="com.dmc.goyiyi.feature.map.ui.MapFragment"
        android:label="Mapa" />

    <fragment
        android:id="@+id/profile_dest"
        android:name="com.dmc.goyiyi.feature.profile.ui.ProfileFragment"
        android:label="Perfil" />

    <fragment
        android:id="@+id/event_detail_dest"
        android:name="com.dmc.goyiyi.feature.events.ui.EventDetailFragment"
        tools:layout="@layout/fragment_event_detail">

        <argument
            android:name="eventId"
            app:argType="integer" />
    </fragment>
</navigation>
